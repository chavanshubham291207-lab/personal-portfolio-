# Server Configuration
PORT=5000

# Database Configuration
# Replace with your local MongoDB URI or MongoDB Atlas URI
MONGODB_URI=mongodb://localhost:27017/portfolio

# Authentication Security
JWT_SECRET=supersecretportfoliojwttokenchangeinprod

# Admin Default Credentials (used to seed DB if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email SMTP Credentials (for contact form confirmation mailer)
# SMTP host (e.g. smtp.gmail.com)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
